# Shared
NODE_ENV=development

# Frontend
NEXT_PUBLIC_APP_NAME=VetVision AI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://vetvision:vetvision@localhost:5432/vetvision

# PostgreSQL
POSTGRES_DB=vetvision
POSTGRES_USER=vetvision
POSTGRES_PASSWORD=vetvision
POSTGRES_PORT=5432

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=veterinary-assets

# AI Workspace
AI_MODEL_DIR=./ai/models
AI_DEVICE=cpu
